 "segments": [
  {
   "start": 0.0,
   "end": 7.9,
   "text": "Kalau kamu bikin aturan bunga paling gampang, hitung dari pinjaman awal, kamu sudah punya bunga flat, tapi kelihatannya murah."
  },
  {
   "start": 8.24,
   "end": 10.38,
   "text": "Padahal aslinya lebih mahal."
  },
  {
   "start": 10.96,
   "end": 14.26,
   "text": "Jadi Pak Dodi minjem 12 juta buat beli mesin mollen."
  },
  {
   "start": 14.74,
   "end": 18.4,
   "text": "Bunganya 1% per bulan, flat selama setahun."
  },
  {
   "start": 18.82,
   "end": 21.14,
   "text": "Kelihatannya cuma 12% per tahun."
  },
  {
   "start": 21.66,
   "end": 26.72,
   "text": "Jadi tiap bulan dia bayar 1 juta pokok plus 120 ribu bunga."
  },
  {
   "start": 26.72,
   "end": 29.68,
   "text": "Cicilannya sama terus, gampang diingat."
  },
  {
   "start": 30.02,
   "end": 32.86,
   "text": "Tapi utangnya terus turun karena dicicil."
  },
  {
   "start": 33.28,
   "end": 36.04,
   "text": "Di bulan ke enam, sisa utangnya tinggal separuh."
  },
  {
   "start": 36.3,
   "end": 39.04,
   "text": "Sementara bunganya tetap 120 ribu."
  },
  {
   "start": 39.34,
   "end": 43.08,
   "text": "Jadi Pak Dodi bayar bunga buat uang yang sudah dia balikin."
  },
  {
   "start": 43.46,
   "end": 48.04,
   "text": "Kalau dihitung dari sisa utang, bunganya sekitar 21% per tahun."
  },
  {
   "start": 48.48,
   "end": 50.14,
   "text": "Namanya bunga efektif."
  },
  {
   "start": 50.5,
   "end": 56.06,
   "text": "Itu angka yang sebenarnya kamu bayar dan hampir 2x lipat dari 12% tadi."
  },
  {
   "start": 56.06,
   "end": 60.02,
   "text": "Tapi jujur aja, bunga flat nggak selalu jelek."
  },
  {
   "start": 60.36,
   "end": 62.68,
   "text": "Cicilannya tetap, jadi gampang diatur."
  },
  {
   "start": 63.18,
   "end": 66.54,
   "text": "Masalahnya kalau dibandingin langsung sama bunga efektif."
  },
  {
   "start": 66.9,
   "end": 70.58,
   "text": "Jadi sebelum minjem, tanya bunga efektifnya per tahun berapa."
  },
  {
   "start": 71.0,
   "end": 73.08,
   "text": "Cek juga biaya admin dan asuransinya."
  },
  {
   "start": 73.5,
   "end": 75.68,
   "text": "Karena itu biaya tambahan di luar bunga."
  },
  {
   "start": 76.24,
   "end": 77.82,
   "text": "Nah itu jawabannya."
  },
  {
   "start": 78.36,
   "end": 81.66,
   "text": "Bunga flat kelihatan murah karena dihitung dari utang awal."
  },
  {
   "start": 81.98,
   "end": 83.04,
   "text": "Bukan sisa utang."
  },
  {
   "start": 83.38,
   "end": 85.58,
   "text": "Pertanyaan berikutnya kamu yang pilih."
  },
  {
   "start": 85.58,
   "end": 86.68,
   "text": "Tulis di komentar."
  },
  {
   "start": 86.98,
   "end": 88.48,
   "text": "Nanti Noel menjawab."
  }
 ],
