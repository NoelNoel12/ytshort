 "segments": [
  {
   "start": 0.0,
   "end": 2.28,
   "text": "Kenapa sinyal HP hilang di dalam lift?"
  },
  {
   "start": 2.94,
   "end": 6.78,
   "text": "Kalau kamu bikin lift dari logam, kamu sudah punya kotak yang kuat."
  },
  {
   "start": 7.2,
   "end": 10.0,
   "text": "Tapi kotak itu juga bikin sinyal susah masuk."
  },
  {
   "start": 10.58,
   "end": 12.94,
   "text": "Jadi, Pak Dodi masuk lift sambil telefon."
  },
  {
   "start": 13.6,
   "end": 14.96,
   "text": "Di lobby, sinyalnya penuh."
  },
  {
   "start": 15.36,
   "end": 19.68,
   "text": "Begitu pintu tertutup, sinyalnya melemah, dan telefonnya bisa putus."
  },
  {
   "start": 20.04,
   "end": 22.78,
   "text": "Tapi kenapa? Logam itu penghantar."
  },
  {
   "start": 23.34,
   "end": 27.32,
   "text": "Gelombang sinyal yang menabrak dindingnya menggeser muatan listrik di logam,"
  },
  {
   "start": 27.32,
   "end": 30.22,
   "text": "dan itu melemahkan gelombang di dalam kotak."
  },
  {
   "start": 30.52,
   "end": 32.76,
   "text": "Namanya Effek Sankar Faraday."
  },
  {
   "start": 32.96,
   "end": 38.26,
   "text": "Dia nggak nahan sinyal dengan sempurna, tapi cukup bikin sinyal di dalam jauh melemah."
  },
  {
   "start": 38.62,
   "end": 41.84,
   "text": "Jadi caranya, bikin sinyal baru di dalam kotaknya."
  },
  {
   "start": 42.3,
   "end": 44.02,
   "text": "Antena di luar menangkap sinyal."
  },
  {
   "start": 44.42,
   "end": 48.22,
   "text": "Kabelnya masuk, lalu antena kecil di dalam yang menyebarkannya."
  },
  {
   "start": 48.6,
   "end": 50.8,
   "text": "Tapi lift itu bergerak naik turun."
  },
  {
   "start": 51.12,
   "end": 54.92,
   "text": "Jadi antenanya bisa dipasang di poros lift, bukan ikut kabin."
  },
  {
   "start": 55.480000000000004,
   "end": 58.84,
   "text": "Tapi jujur aja, nggak semua lift sinyalnya langsung mati."
  },
  {
   "start": 59.24,
   "end": 61.7,
   "text": "Tergantung bahan dan penguat sinyal di gedungnya."
  },
  {
   "start": 62.12,
   "end": 66.2,
   "text": "Jadi kalau lagi penting, selesaikan telefonnya sebelum masuk lift."
  },
  {
   "start": 66.54,
   "end": 70.24,
   "text": "Atau kasih tahu dulu lawan bicara mu, biar nggak dikira ngilang."
  },
  {
   "start": 70.82,
   "end": 72.34,
   "text": "Nah, itu jawabannya."
  },
  {
   "start": 72.86,
   "end": 77.12,
   "text": "Sinyal melemah karena kotak logam lift bekerja seperti Sankar Faraday."
  },
  {
   "start": 77.46,
   "end": 79.68,
   "text": "Pertanyaan berikutnya kamu yang pilih."
  },
  {
   "start": 79.9,
   "end": 82.48,
   "text": "Tulis di komentar, nanti Noel menjawab."
  }
 ],
